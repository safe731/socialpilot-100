# ==========================================
# SocialPilot 100+ Environment Variables
# ==========================================

# Supabase PostgreSQL & Auth Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Meta Developer App Credentials (for SocialPilot 100 app)
# Found in: https://developers.facebook.com/apps/ -> App Settings -> Basic
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_REDIRECT_URI="https://your-domain.com/auth/callback"

# Application URL & Routing
NEXT_PUBLIC_APP_URL="https://your-domain.com"
APP_URL="https://your-domain.com"
PORT=3000

# Queue & Background Scheduler Security Token
QUEUE_PROVIDER_TOKEN="your_secure_queue_cron_secret_token"

# Optional Gemini AI Assistant for post copy enhancements
GEMINI_API_KEY=""
